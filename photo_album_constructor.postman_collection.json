	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					  "const csrfCookie = pm.cookies.toObject()['csrftoken'];",
					  "if (csrfCookie) {",
					  "    pm.request.headers.add({",
					  "        key: 'X-CSRFToken',",
					  "        value: csrfCookie",
					  "    });",
					  "}"
				]
			}
		},
